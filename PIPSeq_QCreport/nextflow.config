/*
 * PIPSeq_QCreport -- default configuration.
 *
 * The Python tool being wrapped lives, unmodified, in perturbseq_report_v1.3.5/
 * next to this file (params.pipeline_dir below). To upgrade it: drop in a new
 * perturbseq_report_vX.Y.Z/ folder and update pipeline_dir and the Dockerfile
 * COPY line to match -- nothing else here is version-specific.
 */

manifest {
    name            = 'PIPSeq_QCreport'
    description     = 'Perturb-seq QC and analysis report pipeline (wraps perturbseq_report)'
    author          = 'yumingcaocym'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.3.5'
}

params {
    // ---------------------------------------------------------------- I/O
    manifest      = null          // required: path or glob to sample manifest(s)
    outdir        = 'results'
    publish_mode  = 'copy'
    help          = false

    // ------------------------------------------------------ container image
    // RUN_QC_REPORT's `container { }` directive reads this directly (see
    // modules/local/run_qc_report.nf) rather than a Nextflow profile: ICA
    // (and most cloud/container-native executors) does not reliably apply
    // profiles, so a container wired up only under `-profile docker` can
    // silently never activate -- confirmed the hard way when this pipeline
    // first ran on ICA with no container at all.
    //
    // Defaults to the image built from containers/Dockerfile, pushed public
    // to Google Artifact Registry (containers/build_and_push_gcp.sh) so ICA
    // can pull it with zero credentials configured, exactly like a public
    // Docker Hub image -- verified with an actual unauthenticated
    // `docker pull`. Override with --qc_container to point at a rebuilt
    // image (AWS ECR via containers/build_and_push.sh works too -- see
    // containers/SETUP.md for both paths), or set it to '' for a
    // genuinely container-free run (conda or bare metal with the
    // dependencies already installed).
    qc_container  = 'us-central1-docker.pkg.dev/methods-dev-lab/pipseq-qcreport/pipseq-qcreport:1.3.5'

    // ------------------------------------------------------------ run mode
    mode          = 'default'     // 'default' | 'explore' | 'auto'

    // --------------------------------------------------------- QC thresholds
    min_genes     = null
    max_genes     = null
    min_counts    = null
    max_counts    = null
    max_mito      = null

    // ------------------------------------------------------------- general
    config              = null
    counts_layer        = null
    subsample_cells     = null
    conditions          = null
    doublets            = false
    no_cell_cycle       = false
    regress_qc          = false
    skip_input_check    = false
    force_recompute     = false
    cluster_col         = null
    low_memory          = false
    batch_correct       = null   // 'none' | 'harmony'
    hvg_batch_key       = null
    resolution          = null
    n_top_genes         = null

    // --------------------------------------------------------- guide calling
    guide_min_reads     = null
    guide_purity_min    = null
    ntc_label           = null
    dual_guide          = 'auto'   // 'auto' | 'dual' | 'single'

    // -------------------------------------------------------------- hashtags
    hto_threshold_mode  = null
    hto_quantile        = null

    // ---------------------------------------------------------------- report
    title               = null
    link_figures        = false
    no_tables           = false
    max_de_targets      = null

    // --------------------------------------------------------------- escape
    extra_args          = null   // anything else, passed to the CLI verbatim

    // ---------------------------------------------------------- environment
    pipeline_dir  = "${projectDir}/perturbseq_report_v1.3.5"
}

profiles {
    conda {
        conda.enabled          = true
        process.conda          = "${projectDir}/envs/environment.yml"
    }

    docker {
        // Tells Nextflow to actually wrap each task in `docker run`; the
        // image itself comes from --qc_container (see the params block
        // above), not from a profile-set value, so it can't be silently
        // skipped on a platform that ignores -profile.
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }

    singularity {
        // Build with: singularity build pipseq-qcreport_1.3.5.sif docker-daemon://<image you pushed>
        // then pass that .sif path as --qc_container.
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    test {
        includeConfig 'conf/test.config'
    }

    local {
        process.executor = 'local'
    }
}

includeConfig 'conf/base.config'

// Timestamped run reports, dropped next to the outputs rather than the
// working directory, so a batch of runs doesn't clobber one another's.
def trace_ts = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_ts}.svg" }
