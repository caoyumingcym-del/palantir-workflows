/*
 * Default resource requests.
 *
 * perturbseq_report is single-threaded (n_jobs=-1 helps scanpy's own internal
 * BLAS/regress_out/neighbors calls, but the stage orchestration itself is
 * one process). Memory is the binding constraint, not CPU: the package's own
 * README_ICA.md quotes ~48-64 GB / 1-2h for a 339k-cell x 38.6k-gene
 * reference experiment. Retries escalate memory rather than assuming a
 * transient failure, since an OOM kill is the overwhelmingly likely cause of
 * a non-zero exit here (see pipeline.py's own matrix-size warnings).
 */

process {
    cpus   = 4
    memory = { 32.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_high_memory' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { 6.h * task.attempt }
        maxRetries = 3
    }

    withLabel: 'process_low' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
}

executor {
    // Conservative default so a laptop/single-node run doesn't oversubscribe;
    // raise this (or set queueSize per HPC executor in your own config) once
    // you're pointed at a real cluster.
    queueSize = 8
}
