/*
 * Minimal-resource profile for the synthetic smoke test.
 *
 * Generate the test data first (once):
 *   python3 bin/make_test_data.py --outdir test_data
 *
 * Then:
 *   nextflow run . -profile test,docker      # or -profile test,conda / plain -profile test
 *
 * This does not validate the SCIENCE of the report (the synthetic generator's
 * planted ground truth is checked by the package's own
 * tests/test_end_to_end.py, not by this pipeline) -- it only proves the
 * Nextflow plumbing (staging, CLI invocation, output publishing) works
 * end to end on a dataset small enough to run in a couple of minutes.
 */

params {
    manifest = 'test_data/sample_manifest.csv'
    mode     = 'auto'
    outdir   = 'results_test'
}

process {
    withLabel: 'process_high_memory' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 20.min * task.attempt }
    }
    cpus   = 2
    memory = { 4.GB * task.attempt }
    time   = { 20.min * task.attempt }
}
